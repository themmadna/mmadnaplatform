# UFC Web App — required environment variables
# Copy this file to .env and fill in your values.
# Requires Python 3.9 for all scraper scripts.

# ── Frontend (React / Vercel) ──────────────────────────────────────────────────
# Your Supabase project URL (safe to expose in the browser)
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — scoped to RLS-enforced read/write
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# ── Python scrapers ────────────────────────────────────────────────────────────
# Service role key — bypasses RLS; used by all scraper write operations.
# NEVER expose this in the browser or commit the real value.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Deploy scripts (supabase/*.py) ────────────────────────────────────────────
# Supabase Management API key — used to deploy RPC functions and run SQL.
# Also used as SUPABASE_ACCESS_TOKEN when the deploy scripts invoke the
# Supabase CLI as a subprocess.
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_KEY=sbp_your-management-key-here
